# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Third-party assets fetched by tools/blender (see README there)
/tools/blender/vendor/
/tools/blender/out/

# Motion-capture inputs are licensed for embedding, not redistribution (Mixamo); outputs are scratch
/tools/mocap/in/
/tools/mocap/out/

# OpenSim inputs are fetched by the workflow; outputs are scratch
/tools/opensim/vendor/
/tools/opensim/out/

# MyoFullBody model (Apache-2.0, fetched by tools/myo) and its Python environment
/tools/myo/vendor/
/tools/myo/.venv/
/tools/myo/out/
__pycache__/
